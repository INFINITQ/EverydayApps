{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Folio Slides",
  "version": "0.1.0",
  "identifier": "app.folio.slides",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm --filter @folio/slides dev:web",
    "beforeBuildCommand": "pnpm --filter @folio/slides build:web"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Folio",
    "shortDescription": "Private, offline PowerPoint viewer and editor",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["pptx"],
        "name": "Folio.PPTX",
        "description": "PowerPoint presentation",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      },
      {
        "ext": ["pptm"],
        "name": "Folio.PPTM",
        "description": "PowerPoint macro-enabled presentation",
        "role": "Editor",
        "mimeType": "application/vnd.ms-powerpoint.presentation.macroEnabled.12"
      },
      {
        "ext": ["ppt"],
        "name": "Folio.PPT",
        "description": "PowerPoint 97-2003 presentation",
        "role": "Viewer",
        "mimeType": "application/vnd.ms-powerpoint"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
