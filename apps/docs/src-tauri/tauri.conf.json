{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Folio Docs",
  "version": "0.1.0",
  "identifier": "app.folio.docs",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm --filter @folio/docs dev:web",
    "beforeBuildCommand": "pnpm --filter @folio/docs build:web"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Folio",
    "shortDescription": "Private, offline Word document editor",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["docx"],
        "name": "Folio.DOCX",
        "description": "Word document",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": ["docm"],
        "name": "Folio.DOCM",
        "description": "Word macro-enabled document",
        "role": "Editor",
        "mimeType": "application/vnd.ms-word.document.macroEnabled.12"
      },
      {
        "ext": ["doc"],
        "name": "Folio.DOC",
        "description": "Word 97-2003 document",
        "role": "Viewer",
        "mimeType": "application/msword"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installMode": "currentUser", "installerHooks": "installer-hooks.nsh" }
    }
  }
}
