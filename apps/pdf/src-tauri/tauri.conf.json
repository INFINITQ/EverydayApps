{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Folio PDF",
  "version": "0.1.0",
  "identifier": "app.folio.pdf",
  "build": {
    "devUrl": "http://localhost:5171",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm --filter @folio/pdf dev:web",
    "beforeBuildCommand": "pnpm --filter @folio/pdf build:web"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Folio",
    "shortDescription": "Private, offline PDF viewer and editor",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "Folio.PDF",
        "description": "PDF document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installMode": "currentUser", "installerHooks": "installer-hooks.nsh" }
    }
  }
}
