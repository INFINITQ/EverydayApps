{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Folio Hello",
  "version": "0.1.0",
  "identifier": "dev.folio.hello",
  "build": {
    "devUrl": "http://localhost:5170",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm --filter @folio/hello dev:web",
    "beforeBuildCommand": "pnpm --filter @folio/hello build:web"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
