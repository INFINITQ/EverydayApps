{
  "$comment": "Master copy of the `app.security` block. Every app's tauri.conf.json must contain exactly this; a test fails if they drift. Allows only the app itself and Tauri's IPC: no remote scripts, images, fonts or connections.",
  "csp": {
    "default-src": "'self'",
    "script-src": "'self' 'wasm-unsafe-eval'",
    "style-src": "'self' 'unsafe-inline'",
    "img-src": "'self' blob: data:",
    "media-src": "'self' blob: data:",
    "font-src": "'self' data:",
    "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
    "worker-src": "'self' blob:",
    "frame-src": "'none'",
    "object-src": "'none'",
    "base-uri": "'none'",
    "form-action": "'none'"
  },
  "dangerousDisableAssetCspModification": ["style-src"],
  "freezePrototype": true,
  "capabilities": ["main"]
}
